# GreenLens Environment Configuration

APP_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

# Database
DATABASE_URL=sqlite:///./greenlens.db

# Provider Configuration
# Options: mock, plantnet
PLANT_IDENTIFICATION_PROVIDER=mock
PLANTNET_API_KEY=

# Options: mock, open
BIRD_IDENTIFICATION_PROVIDER=mock
BIRD_PROVIDER_API_KEY=

# Options: mock, open
INSECT_IDENTIFICATION_PROVIDER=mock
INSECT_PROVIDER_API_KEY=

# File Upload Settings
MAX_UPLOAD_MB=10
UPLOAD_DIR=./uploads

# Campus Settings
CAMPUS_NAME=GreenLens Central Campus
CAMPUS_BOUNDARY_FILE=../data/campus/campus_boundary.geojson
STRICT_CAMPUS_BOUNDARY=false
